  <%- include('partials/header') %>
  <body>
    <div class="main">
      <div class="container">
        <div class="main-content">
          <h1> Blogs</h1>
          <div class="posts">
            <% if(posts.length <1) { %>
                        <h3 style="text-align: center; color: rgb(107, 102, 102); margin-top:20px ;">No Posts Yet</h3>
            <p>Be the first to create a post!</p>
            <% } else { %>
              <% posts.forEach((element) => { %>
                <div class="post">
                  <a href="/post/<%=element.id%>"><h2><%= element.title %></h2></a>
                <% if(element.content.length>500) {%>
                  <p><%=element.content.slice(0,500)%>...<a href="/post/<%=element.id%>">see more</a></p>
                <% }else{ %>
                  <p><%= element.content %></p>
                <% } %>
                  <form action="/post/<%=element.id%>/delete" method="post" class="delete-post-form">
                    <div class="post-action-btn">

                      <div>
                        <button type="submit" class="delete-btn">Delete Post</button>
                        <a href="./post/<%=element.id %>/edit" class="edit-btn">Edit Post</a>
                      </div>
                      <div>
                       <a href="/post/<%=element.id %>/public" class="share-btn">Share</a>
                      </div>

                    </div>


                  </form>

                </div>
              <% }); %>
              <% } %>
          </div>
        
        </div>
        <div class="modal hidden" id="deleteModal">
  <div class="box">
    <div>
      <h1>Delete post?</h1>
      <p>Are you sure you want to delete this post? This can’t be undone.</p>
    </div>
    <div>
 <button type="button" id="cancelDelete">Cancel</button>
      <button type="button" id="confirmDelete">Delete</button>
    </div>
  </div>
</div>
      </div>
    </div>
  </body>



  <%- include('partials/footer') %>

  <script src="js/script.js"></script>

