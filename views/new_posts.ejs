<%- include('partials/header') %>
<body>
  <div class="main">
    <div class="container">
      <div class="main-content">
        <h1>ur blog</h1>
        <p>
          Welcome to the blog posts page. Here you can post ur thoughts and
          ideas.
        </p>
      </div>
      <div class="form">
        <form action="/post" method="post">
          <label for="postTitle">Post Title:</label>
          <input
            type="text"
            name="postTitle"
            id="postTitle"
            placeholder="Type the tilt here"
            required
          />
          <label for="postContent">the Content</label>
          <textarea
            name="postContent"
            id="postContent"
            placeholder="Type the content here "
            required
          ></textarea>
          <input type="submit" />
        </form>
      </div>
    </div>
  </div>
</body>
<%- include('partials/footer') %>
<div class="modal hidden">
  <div class="box">
    <div>
      <h1>Delete post?</h1>
      <p>Are you sure you want to delete this post? This can’t be undone.</p>
    </div>
    <div>
      <button>Cancel</button>
      <button>Delete</button>
    </div>
  </div>
</div>
